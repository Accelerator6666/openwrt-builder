#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG="/usr/bin/kixdns"
CFG="/etc/kixdns/pipeline.json"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -s "$CFG" ] || return 1

	procd_open_instance
	procd_set_param command "$PROG" run -c "$CFG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65536 65536"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "kixdns"
}
